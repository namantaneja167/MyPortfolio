---
import Icon from '../components/Icon.astro';
import profile from '../content/profile.json';

const mailto = `mailto:${profile.email}?subject=${encodeURIComponent(
  'Opportunity for Naman Taneja',
)}&body=${encodeURIComponent(
  'Hi Naman,\n\nRole / project:\nTeam:\nTimeline:\n\n',
)}`;

const connect = [
  { name: 'Email', href: mailto, icon: 'mail', handle: profile.email },
  { name: 'LinkedIn', href: profile.socials.linkedin, icon: 'linkedin', handle: 'in/namantaneja167' },
  { name: 'GitHub', href: profile.socials.github, icon: 'github', handle: 'namantaneja167' },
  { name: 'Medium', href: profile.socials.medium, icon: 'medium', handle: '@namantaneja167' },
  { name: 'X', href: profile.socials.twitter, icon: 'twitter', handle: '@naman_taneja_' },
] as const;
---
<section id="contact" class="py-24 sm:py-28 border-t border-[rgb(var(--harbor-border)/0.08)]">
  <div class="max-w-[var(--harbor-container-xl)] mx-auto px-5 sm:px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

    <div class="lg:col-span-6 reveal">
      <span class="font-mono text-xs font-bold tracking-[0.2em] text-accent">06</span>
      <h2 class="mt-3 text-fluid-h2 font-display font-bold tracking-tight uppercase text-fg leading-[0.95]">
        Let's work<br />together
      </h2>

      <p class="mt-6 max-w-md text-fluid-lead leading-relaxed text-fg-muted">
        Open to data engineering roles and consulting work. Send the scope, timeline and
        constraints — you'll get a clear next step back.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row gap-3">
        <a
          href={mailto}
          class="btn-accent inline-flex items-center justify-center gap-2 min-h-12 px-6 text-sm font-semibold rounded-xl"
        >
          <Icon name="mail" size={17} />
          Email me
        </a>

        <button
          type="button"
          data-copy={profile.email}
          class="btn-ghost inline-flex items-center justify-center gap-2 min-h-12 px-6 text-sm font-semibold rounded-xl"
        >
          <Icon name="copy" size={17} class="[[data-copied]_&]:hidden" />
          <Icon name="check" size={17} class="hidden [[data-copied]_&]:block text-[rgb(var(--harbor-success))]" />
          <span class="[[data-copied]_&]:hidden">Copy address</span>
          <span class="hidden [[data-copied]_&]:inline">Copied</span>
        </button>
      </div>

      <p class="mt-5 font-mono text-sm text-fg-subtle">{profile.email}</p>
    </div>

    <div class="lg:col-span-6 flex flex-col gap-4 reveal" style="--reveal-delay: 90ms">
      <div class="flex items-center gap-3.5 p-5 surface-card">
        <span class="relative flex w-2.5 h-2.5 shrink-0">
          <span class="absolute inline-flex w-full h-full rounded-full bg-[rgb(var(--harbor-success))] opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex w-2.5 h-2.5 rounded-full bg-[rgb(var(--harbor-success))]"></span>
        </span>
        <div>
          <span class="block font-mono text-[0.625rem] font-bold uppercase tracking-[0.16em] text-fg-subtle">
            Status
          </span>
          <span class="block mt-0.5 text-sm font-semibold text-fg">{profile.status}</span>
        </div>
      </div>

      <div class="p-5 surface-card">
        <span class="block mb-2 font-mono text-[0.625rem] font-bold uppercase tracking-[0.16em] text-fg-subtle">
          Connect
        </span>

        <ul>
          {connect.map((link) => (
            <li class="border-t border-[rgb(var(--harbor-border)/0.08)] first:border-t-0">
              <a
                href={link.href}
                target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                class="group flex items-center gap-4 min-h-14 py-2 rounded-lg transition-colors hover:text-accent"
              >
                <Icon name={link.icon} size={18} class="shrink-0 text-accent-2 transition-colors group-hover:text-accent" />
                <span class="flex-1 min-w-0">
                  <span class="block text-sm font-semibold text-fg group-hover:text-accent transition-colors">
                    {link.name}
                  </span>
                  <span class="block font-mono text-xs text-fg-subtle truncate">{link.handle}</span>
                </span>
                <Icon
                  name="arrowUpRight"
                  size={16}
                  class="shrink-0 text-fg-subtle transition-transform group-hover:-translate-y-0.5 group-hover:text-accent"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a
        href={profile.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost inline-flex items-center justify-center gap-2 min-h-13 px-6 py-4 text-sm font-semibold rounded-2xl"
      >
        <Icon name="download" size={17} />
        Download resume (PDF)
      </a>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    let timer: number;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
      } catch {
        return; // Clipboard blocked — the address is printed next to the button.
      }
      btn.toggleAttribute('data-copied', true);
      clearTimeout(timer);
      timer = window.setTimeout(() => btn.removeAttribute('data-copied'), 2000);
    });
  });
</script>
