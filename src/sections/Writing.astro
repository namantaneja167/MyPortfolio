---
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import profile from '../content/profile.json';

interface Article {
  title: string;
  link: string;
  date: string;
  isoDate: string;
  excerpt: string;
  tags: string[];
}

const FEED = 'https://medium.com/feed/@namantaneja167';

const decode = (s: string) =>
  s
    .replace(/<!\[CDATA\[|\]\]>/g, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16)))
    .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();

const pick = (block: string, tag: string) =>
  decode(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)</${tag}>`).exec(block)?.[1] ?? '');

const ACRONYMS: Record<string, string> = {
  sql: 'SQL', ai: 'AI', etl: 'ETL', api: 'API', rag: 'RAG',
  llm: 'LLM', cli: 'CLI', ml: 'ML', dbt: 'dbt', aws: 'AWS',
};

const titleCase = (slug: string) =>
  slug
    .split('-')
    .map((w) => ACRONYMS[w.toLowerCase()] ?? w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

/** Cut at a word boundary instead of mid-word. */
const truncate = (text: string, max: number) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:.\-–—]$/, '')}…`;
};

const fallback: Article[] = [
  {
    title: 'SnowSQL: The Data Engineer’s Guide to Snowflake’s CLI',
    link: profile.socials.medium,
    date: 'Recent',
    isoDate: '',
    excerpt:
      'Snowsight is great for exploring data, but scripted, repeatable work belongs in the CLI. A practical tour of SnowSQL for day-to-day pipeline work.',
    tags: ['Data Engineering', 'Snowflake'],
  },
];

// Fetched at build time: no client JS, no CORS proxy, and no third-party
// HTML reaching innerHTML in the browser.
let articles: Article[] = [];

try {
  const res = await fetch(FEED, {
    headers: { 'User-Agent': 'portfolio-build' },
    signal: AbortSignal.timeout(10_000),
  });
  if (!res.ok) throw new Error(`Medium feed returned ${res.status}`);

  const xml = await res.text();
  const items = xml.match(/<item>[\s\S]*?<\/item>/g) ?? [];

  articles = items.slice(0, 3).map((block) => {
    // Medium exposes only a teaser; grab the snippet paragraph so the
    // "Continue reading on Medium" footer never leaks into the excerpt.
    const snippet =
      /<p class="medium-feed-snippet">([\s\S]*?)<\/p>/.exec(block)?.[1] ??
      pick(block, 'description');
    const published = new Date(pick(block, 'pubDate'));

    return {
      title: pick(block, 'title'),
      link: (/<link>([\s\S]*?)<\/link>/.exec(block)?.[1] ?? profile.socials.medium)
        .trim()
        .split('?')[0],
      date: Number.isNaN(published.valueOf())
        ? 'Recent'
        : new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' }).format(published),
      isoDate: Number.isNaN(published.valueOf()) ? '' : published.toISOString(),
      excerpt: truncate(decode(snippet).replace(/\s*Continue reading on Medium.*$/i, ''), 165),
      tags: [...block.matchAll(/<category[^>]*>([\s\S]*?)<\/category>/g)]
        .slice(0, 2)
        .map((m) => titleCase(decode(m[1]))),
    };
  });
} catch (error) {
  console.warn('[Writing] Medium feed unavailable at build time, using fallback.', error);
}

if (articles.length === 0) articles = fallback;
---
<section id="blog" class="py-24 sm:py-28 border-t border-[rgb(var(--harbor-border)/0.08)]">
  <div class="max-w-[var(--harbor-container-xl)] mx-auto px-5 sm:px-6 w-full">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-14">
      <SectionHeading index="05" title="Writing" lead="Notes from the pipeline." />

      <a
        href={profile.socials.medium}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal btn-ghost inline-flex items-center gap-2 min-h-11 px-4 text-sm font-semibold rounded-lg"
      >
        All posts on Medium
        <Icon name="arrowUpRight" size={16} />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {articles.map((article, i) => (
        <article
          class="reveal surface-card spotlight flex flex-col p-6 sm:p-7"
          style={`--reveal-delay: ${i * 80}ms`}
        >
          <div class="flex flex-wrap gap-2">
            {article.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>

          <h3 class="mt-5 font-display font-bold text-xl leading-snug text-fg">
            <a
              href={article.link}
              target="_blank"
              rel="noopener noreferrer"
              class="after:absolute after:inset-0 hover:text-accent transition-colors"
            >
              {article.title}
            </a>
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-fg-muted">{article.excerpt}</p>

          <p class="mt-auto pt-6 font-mono text-xs text-fg-subtle">
            {article.isoDate
              ? <time datetime={article.isoDate}>{article.date}</time>
              : <span>{article.date}</span>}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
