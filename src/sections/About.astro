---
import Icon from '../components/Icon.astro';
import profile from '../content/profile.json';
---
<section id="about" class="py-24 sm:py-28 border-t border-[rgb(var(--harbor-border)/0.08)]">
  <div class="max-w-[var(--harbor-container-xl)] mx-auto px-5 sm:px-6 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

    <div class="lg:col-span-5 reveal">
      <div class="flex items-baseline gap-3">
        <span class="font-mono text-xs font-bold tracking-[0.2em] text-accent">01</span>
        <h2 class="text-fluid-h2 font-display font-bold tracking-tight uppercase text-fg">About</h2>
      </div>

      <blockquote class="mt-8 border-l-[3px] border-accent pl-6 py-1">
        <p class="font-display font-medium text-2xl sm:text-3xl leading-[1.25] text-accent-3">
          {profile.pullquote}
        </p>
      </blockquote>
    </div>

    <div class="lg:col-span-7 flex flex-col gap-8 reveal" style="--reveal-delay: 90ms">
      <div class="space-y-5 text-fluid-lead leading-relaxed text-fg-muted">
        <p>
          I'm a Senior Technical Consultant with <strong class="text-fg font-semibold">3+ years</strong>
          delivering enterprise-scale data engineering across energy trading and pharma analytics.
        </p>
        <p>
          At <strong class="text-fg font-semibold">Uniper</strong> I led the end-to-end migration of a
          mission-critical ETRM system from CXL to Endur — architecting the full data flow from source
          ingestion through business-ready reporting, and taking it live to production. I was the first
          India-based hire on the UGCNA Data Strategy team and now lead and mentor the engineers who
          joined after me.
        </p>
        <p>
          Before that, at <strong class="text-fg font-semibold">ZS Associates</strong>, I ran ETL over
          a billion healthcare records for the largest US pharma client and automated the reporting
          that analysts had been assembling by hand.
        </p>
      </div>

      <div class="p-6 surface-card">
        <span class="block mb-3 font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent-2">
          Core stack
        </span>
        <p class="font-mono text-sm sm:text-base leading-relaxed text-fg">
          {profile.stack}
        </p>
      </div>

      <div class="flex flex-wrap gap-x-8 gap-y-4 text-sm font-medium text-fg-subtle">
        <span class="inline-flex items-center gap-2.5">
          <Icon name="mapPin" size={17} class="text-accent" />
          {profile.location}
        </span>
        <span class="inline-flex items-center gap-2.5">
          <Icon name="globe" size={17} class="text-accent" />
          {profile.languages}
        </span>
      </div>
    </div>

  </div>
</section>
