---
import SectionHeading from '../components/SectionHeading.astro';
import rawSkillRows from '../content/skills.json';
import { SkillCollectionSchema } from '../content/schema';

const skillRows = SkillCollectionSchema.parse(rawSkillRows).map((row) => ({
  ...row,
  itemsList: row.items.split(',').map((s) => s.trim()).filter(Boolean),
}));
---
<section id="skills" class="py-24 sm:py-28 border-t border-[rgb(var(--harbor-border)/0.08)]">
  <div class="max-w-[var(--harbor-container-xl)] mx-auto px-5 sm:px-6 w-full">
    <SectionHeading index="03" title="Skills" class="mb-14" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {skillRows.map((row, i) => (
        <div
          class:list={[
            'reveal p-6 sm:p-7 surface-card spotlight flex flex-col',
            row.cool && 'md:col-span-2',
          ]}
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <div class="flex items-center justify-between gap-3 mb-5">
            <h3
              class:list={[
                'font-display font-bold text-lg uppercase tracking-[0.08em]',
                row.cool ? 'text-accent' : 'text-accent-2',
              ]}
            >
              {row.category}
            </h3>
            {row.cool && (
              <span class="shrink-0 px-2.5 py-1 rounded-md font-mono text-[0.625rem] font-bold uppercase tracking-[0.14em] bg-[rgb(var(--harbor-accent)/0.14)] text-accent border border-[rgb(var(--harbor-accent)/0.25)]">
                Core
              </span>
            )}
          </div>

          <ul class="flex flex-wrap gap-2">
            {row.itemsList.map((item) => <li class="tag">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
