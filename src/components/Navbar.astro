---
import Icon from './Icon.astro';
import profile from '../content/profile.json';

const navItems = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'projects', label: 'Projects' },
  { id: 'blog', label: 'Writing' },
];
---
<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-100 transition-[padding,background-color,border-color] duration-300 border-b border-transparent"
>
  <div class="max-w-[var(--harbor-container-xl)] mx-auto px-5 sm:px-6 h-[var(--nav-h)] flex items-center justify-between gap-4">
    <a
      href="#hero"
      class="font-display font-bold text-xl tracking-[0.12em] text-accent hover:text-accent-3 transition-colors py-2"
    >
      NAMAN
    </a>

    <nav class="hidden lg:flex items-center gap-0.5" aria-label="Sections">
      {navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-nav-link={item.id}
          class="nav-link relative px-3.5 py-2 text-sm font-medium rounded-lg text-fg-muted hover:text-fg transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-2.5">
      <button
        type="button"
        data-theme-toggle
        class="btn-ghost grid place-items-center w-11 h-11 rounded-lg"
        aria-label="Switch colour theme"
      >
        <Icon name="sun" size={18} class="hidden [html[data-theme=dark]_&]:block" />
        <Icon name="moon" size={18} class="hidden [html[data-theme=light]_&]:block" />
      </button>

      <a
        href={profile.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost inline-flex items-center gap-2 h-11 px-4 text-sm font-semibold rounded-lg"
      >
        <Icon name="download" size={16} />
        Resume
      </a>

      <a
        href="#contact"
        class="btn-accent inline-flex items-center h-11 px-5 text-sm font-semibold rounded-lg"
      >
        Get in touch
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        data-theme-toggle
        class="btn-ghost grid place-items-center w-11 h-11 rounded-lg"
        aria-label="Switch colour theme"
      >
        <Icon name="sun" size={18} class="hidden [html[data-theme=dark]_&]:block" />
        <Icon name="moon" size={18} class="hidden [html[data-theme=light]_&]:block" />
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="btn-ghost grid place-items-center w-11 h-11 rounded-lg"
      >
        <Icon name="menu" size={20} class="[[aria-expanded=true]_&]:hidden" />
        <Icon name="close" size={20} class="hidden [[aria-expanded=true]_&]:block" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="lg:hidden border-t border-[rgb(var(--harbor-border)/0.10)] bg-[rgb(var(--harbor-bg-elev-1))]"
  >
    <nav class="max-w-[var(--harbor-container-xl)] mx-auto px-5 py-3 flex flex-col" aria-label="Sections">
      {navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-nav-link={item.id}
          data-menu-close
          class="nav-link flex items-center min-h-12 px-2 text-base font-medium text-fg-muted rounded-lg transition-colors"
        >
          {item.label}
        </a>
      ))}

      <div class="flex gap-2.5 pt-3 pb-1">
        <a
          href={profile.resume}
          target="_blank"
          rel="noopener noreferrer"
          data-menu-close
          class="btn-ghost flex-1 inline-flex items-center justify-center gap-2 min-h-12 px-4 text-sm font-semibold rounded-lg"
        >
          <Icon name="download" size={16} />
          Resume
        </a>
        <a
          href="#contact"
          data-menu-close
          class="btn-accent flex-1 inline-flex items-center justify-center min-h-12 px-4 text-sm font-semibold rounded-lg"
        >
          Get in touch
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  #site-header[data-scrolled] {
    background-color: rgb(var(--harbor-bg) / 0.82);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-bottom-color: rgb(var(--harbor-border) / 0.10);
  }

  .nav-link[data-active] {
    color: rgb(var(--harbor-text));
  }

  /* Desktop pill sits behind the label; mobile uses a left accent rule. */
  @media (min-width: 1024px) {
    .nav-link[data-active]::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 0.5rem;
      background-color: rgb(var(--wash) / 0.07);
      border: 1px solid rgb(var(--harbor-border) / 0.10);
      z-index: -1;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const menu = document.getElementById('mobile-menu')!;
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

  // --- Theme -------------------------------------------------------------
  const applyTheme = (theme: 'light' | 'dark') => {
    document.documentElement.setAttribute('data-theme', theme);
    document.querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'light' ? '#faf8f5' : '#100e0d');
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* private mode — the in-memory attribute still applies */
    }
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      applyTheme(current === 'light' ? 'dark' : 'light');
    });
  });

  // --- Header elevation --------------------------------------------------
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 16);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // --- Mobile menu -------------------------------------------------------
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  menuToggle.addEventListener('click', () => {
    setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll('[data-menu-close]').forEach((el) =>
    el.addEventListener('click', () => setMenu(false)),
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuToggle.focus();
    }
  });

  const desktop = window.matchMedia('(min-width: 1024px)');
  desktop.addEventListener('change', (e) => e.matches && setMenu(false));

  // --- Scroll spy --------------------------------------------------------
  // IntersectionObserver instead of measuring offsetTop on every scroll event,
  // which forced a layout recalculation each frame.
  const sections = navLinks
    .map((l) => document.getElementById(l.dataset.navLink!))
    .filter((el): el is HTMLElement => el !== null);

  const visible = new Set<string>();

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target.id);
        else visible.delete(entry.target.id);
      }
      const active = sections.find((s) => visible.has(s.id))?.id;
      navLinks.forEach((link) =>
        link.toggleAttribute('data-active', !!active && link.dataset.navLink === active),
      );
    },
    { rootMargin: '-30% 0px -55% 0px' },
  );

  sections.forEach((section) => spy.observe(section));
</script>
