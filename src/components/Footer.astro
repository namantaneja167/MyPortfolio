---
import Icon from './Icon.astro';
import profile from '../content/profile.json';

const mailto = `mailto:${profile.email}`;
const links = [
  { name: 'Email', href: mailto, icon: 'mail' },
  { name: 'LinkedIn', href: profile.socials.linkedin, icon: 'linkedin' },
  { name: 'GitHub', href: profile.socials.github, icon: 'github' },
  { name: 'Medium', href: profile.socials.medium, icon: 'medium' },
  { name: 'X', href: profile.socials.twitter, icon: 'twitter' },
] as const;

const year = new Date().getFullYear();
---
<footer class="py-12 border-t border-[rgb(var(--harbor-border)/0.08)]">
  <div class="max-w-[var(--harbor-container-xl)] mx-auto px-5 sm:px-6 flex flex-col-reverse md:flex-row items-center justify-between gap-8">
    <p class="font-mono text-xs text-fg-subtle text-center md:text-left">
      © {year} {profile.name}. Built with Astro.
    </p>

    <ul class="flex items-center gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.href.startsWith('mailto:') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            class="grid place-items-center w-11 h-11 rounded-lg text-fg-muted hover:text-accent hover:bg-[rgb(var(--wash)/0.06)] transition-colors"
            aria-label={link.name}
          >
            <Icon name={link.icon} size={19} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
