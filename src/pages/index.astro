---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Experience from '../sections/Experience.astro';
import Skills from '../sections/Skills.astro';
import Projects from '../sections/Projects.astro';
import Writing from '../sections/Writing.astro';
import Contact from '../sections/Contact.astro';
import rawProfile from '../content/profile.json';
import { ProfileSchema } from '../content/schema';

ProfileSchema.parse(rawProfile);
---
<Base>
  <Navbar />

  <main id="main-content">
    <Hero />
    <About />
    <Experience />
    <Skills />
    <Projects />
    <Writing />
    <Contact />
  </main>

  <Footer />
</Base>
