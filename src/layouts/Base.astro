---
import { Font } from 'astro:assets';
import '../styles/global.css';
import profile from '../content/profile.json';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | ${profile.role}`,
  description = 'Data Engineer building Snowflake and Azure pipelines for energy and pharma teams. 1B+ records processed, 300+ KPIs automated.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}/og.jpg`.replace(/\/+/g, '/'), Astro.site);
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content={profile.name} />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>

  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/icon.svg`.replace(/\/+/g, '/')} />
  <link rel="manifest" href={`${import.meta.env.BASE_URL}/manifest.json`.replace(/\/+/g, '/')} />
  <link rel="sitemap" href={`${import.meta.env.BASE_URL}/sitemap-index.xml`.replace(/\/+/g, '/')} />
  <meta name="theme-color" content="#100e0d" />

  <!-- Only the display face is preloaded. Preloading more competes with the
       hero image, which is the LCP element. -->
  <Font cssVariable="--font-barlow" preload />
  <Font cssVariable="--font-figtree" />
  <Font cssVariable="--font-inconsolata" />

  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'none'; object-src 'none'; base-uri 'self'"
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.role,
    email: profile.email,
    url: canonicalURL.href,
    image: ogImage.href,
    sameAs: Object.values(profile.socials),
    description,
    worksFor: { '@type': 'Organization', name: profile.currentEmployer },
    alumniOf: { '@type': 'Organization', name: 'ZS Associates' },
    knowsAbout: ['Data Engineering', 'Snowflake', 'Azure', 'dbt', 'Python', 'SQL', 'ETL'],
  })} />

  <script is:inline>
    // Runs before paint: applies the stored theme so there is no light/dark
    // flash, and flags that JS is alive so `.reveal` may hide its content.
    (() => {
      const root = document.documentElement;
      let theme;
      try { theme = localStorage.getItem('theme'); } catch {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      root.setAttribute('data-theme', theme);
      root.classList.add('js');
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'light' ? '#faf8f5' : '#100e0d');
    })();
  </script>
</head>

<body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>
  <slot />

  <script>
    // Reveal-on-scroll. The CSS only hides `.reveal` while `html.js` is set,
    // so a JS failure leaves every section readable.
    const targets = document.querySelectorAll<HTMLElement>('.reveal');

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      targets.forEach((el) => observer.observe(el));
    } else {
      targets.forEach((el) => el.classList.add('is-visible'));
    }

    // Cursor position for `.spotlight` surfaces. Pointer-precision only, so
    // touch devices never pay for it.
    if (window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('.spotlight').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
          card.style.setProperty('--my', `${e.clientY - rect.top}px`);
        });
      });
    }

    // The pre-Astro build shipped a service worker that pre-cached files which
    // no longer exist. Tear it down so returning visitors escape stale HTML.
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
      if (window.caches) caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
    }
  </script>
</body>
</html>
